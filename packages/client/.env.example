# STUN is always included (stun.l.google.com). Add TURN for NAT traversal behind CGNAT/symmetric NATs (SPEC.md §2).
# Option 1: Full ICE servers JSON array (preferred for short-lived credentials issued by backend)
# VITE_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]'

# Option 2: Discrete TURN vars (simpler for static TURN)
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=user
# VITE_TURN_CREDENTIAL=pass
